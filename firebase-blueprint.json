{
  "entities": {
    "Salon": {
      "title": "Salon",
      "description": "Salon profiles on Tedallaly platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonName": { "type": "string" },
        "city": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "verified", "rejected", "suspended"] },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "slug": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "verificationNotes": { "type": "string" }
      },
      "required": ["id", "salonName", "city", "status"]
    },
    "Service": {
      "title": "Service",
      "description": "Services offered by salons on Tedallaly",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "durationMins": { "type": "number" },
        "isHomeService": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "salonId", "name", "price"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Customer bookings on Tedallaly brokered platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salonId": { "type": "string" },
        "serviceId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "appointmentTime": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "salonId", "customerName", "customerPhone", "appointmentDate", "appointmentTime", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real in-app and push notifications for salon approval, rejection, and appointments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "read": { "type": "boolean" },
        "urgency": { "type": "string" },
        "recipientRole": { "type": "string" },
        "recipientId": { "type": "string" },
        "salonId": { "type": "string" },
        "rejectionReason": { "type": "string" }
      },
      "required": ["id", "type", "title", "message", "timestamp", "read"]
    },
    "User": {
      "title": "User",
      "description": "User profiles authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "city": { "type": "string" },
        "isActive": { "type": "boolean" },
        "linkedProviderId": { "type": "string" }
      },
      "required": ["_id", "name", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user accounts and role definitions"
    },
    "/salons/{salonId}": {
      "schema": { "$ref": "#/entities/Salon" },
      "description": "Public and verified salon entities"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Salons beauty services catalog"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Customer bookings brokered through Tedallaly"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time persistent notifications for salons and customers"
    }
  }
}
